+    /// Every slope drains through its visible foot into the nearest side river.
+    /// The final control point approaches from the outer bank along the river.
+    static func tributaries(layout: WorldSceneryLayout) -> [Tributary] {
+        let s = layout.scale
+        return sources(layout: layout).map { source in
+            let right = source.point.x > layout.width / 2
+            let start = source.outlet
+            let river = channelPoint(layout: layout, right: right, y: source.point.y)
+            var drop = min(148 * s, max(64 * s, abs(start.x - river.x) * 0.42 + 32 * s))
+            if source.id == 4 {
+                drop = min(drop, 1675 - 150 * s - source.point.y - 8 * s)
+            }
+            let end = channelPoint(layout: layout, right: right, y: source.point.y + drop)
+            let before = channelPoint(layout: layout, right: right, y: end.y - 1)
+            let after = channelPoint(layout: layout, right: right, y: end.y + 1)
+            let dx = after.x - before.x, dy = after.y - before.y
+            let length = max(0.001, hypot(dx, dy))
+            let approach = min(24 * s, max(8 * s, (end.y - start.y) * 0.4))
+            let c1 = CGPoint(x: start.x + (end.x - start.x) * 0.12,
+                             y: start.y + (end.y - start.y) * 0.68)
+            let bankSide: CGFloat = right ? 1 : -1
+            let c2 = CGPoint(x: end.x - dx / length * approach + dy / length * bankSide * 7 * s,
+                             y: end.y - dy / length * approach - dx / length * bankSide * 7 * s)
+            let points = (0...48).map { index -> CGPoint in
+                let t = CGFloat(index) / 48, u = 1 - t
+                return CGPoint(x: u*u*u*start.x + 3*u*u*t*c1.x + 3*u*t*t*c2.x + t*t*t*end.x,
+                               y: u*u*u*start.y + 3*u*u*t*c1.y + 3*u*t*t*c2.y + t*t*t*end.y)
+            }
+            return Tributary(id: source.id, points: points)
+        }
+    }
