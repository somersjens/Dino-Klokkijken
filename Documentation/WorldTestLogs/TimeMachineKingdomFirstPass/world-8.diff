+            bank.stroke(water, with: .color(Color(dinoHex: 0x1F618F)), style: StrokeStyle(lineWidth: 19 * s))
+            bank.stroke(water, with: .linearGradient(Gradient(colors: [Color(dinoHex: 0x42DFFF), Color(dinoHex: 0x168DD7), Color(dinoHex: 0x72EAF7)]),
+                startPoint: .init(x: 0, y: start), endPoint: .init(x: 0, y: end)), style: StrokeStyle(lineWidth: 15 * s))
+            bank.stroke(water, with: .color(Color(dinoHex: 0xC0FFFF).opacity(0.7)), style: StrokeStyle(lineWidth: 2 * s))
