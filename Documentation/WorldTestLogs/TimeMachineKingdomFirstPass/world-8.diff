+    /// Cached stonework gives the inventions an inhabited, vertical kingdom.
+    /// Buildings stand on shared terraces; stairs land on those same cornices.
+    private func clockworkKingdom(layout: WorldSceneryLayout) {
+        let s = layout.scale
+        let start = -layout.routeOffset + 62
+        let end = layout.height - layout.routeOffset - 46
+        for right in [false, true] {
+            var bank = context
+            bank.clip(to: TimeMachineLayout.cityBank(layout: layout, right: right))
+            TimeMachineLayout.clipCityTransition(context: &bank,
+                bounds: CGRect(x: -40, y: start, width: layout.width + 80, height: end - start), scale: s)
+            let p = TimeMachinePainter(context: bank)
+            p.material(Path(CGRect(x: -20, y: start, width: layout.width + 40, height: end - start)),
+                       [0xA2A4BE, 0x777E9D, 0x515D7C])
+            // Recessed masonry continues between the buildings and under bridges.
+            p.masonry(in: CGRect(x: 0, y: start, width: layout.width, height: end - start),
+                      course: 20 * s, block: 43 * s, lineWidth: 0.8 * s)
+            let count = Int(ceil((end - start + 150) / 205))
+            for row in 0..<count {
+                let y = start + 167 + CGFloat(row) * 205
+                // Use the narrowest part of this block for complete silhouettes.
+                let limits = (0...12).map { i -> CGFloat in
+                    let x = layout.centerX(at: y - 240 * s + CGFloat(i) * 20 * s)
+                    return right ? layout.width - x - 62 * s : x - 62 * s
+                }
+                let safeWidth = max(48, (limits.min() ?? 80) / s)
+                let edge = layout.centerX(at: y) + (right ? 1 : -1) * 57 * s
+                let deckWidth = (right ? layout.width - edge : edge) / s
+                let stairWidth = (0...8).map { i -> CGFloat in
+                    let x = layout.centerX(at: y - 70 * s + CGFloat(i) * 17.5 * s)
+                    return (right ? layout.width - x - 62 * s : x - 62 * s) / s
+                }.min() ?? deckWidth
+                var local = bank
+                local.translateBy(x: right ? layout.width : 0, y: y)
+                local.scaleBy(x: right ? -s : s, y: s)
+                TimeMachinePainter(context: local).kingdomQuarter(width: max(54, deckWidth),
+                    buildingWidth: safeWidth, stairWidth: stairWidth, variation: row + (right ? 3 : 0))
+            }
