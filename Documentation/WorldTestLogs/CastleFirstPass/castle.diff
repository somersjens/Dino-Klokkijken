+private struct CastleKingdomLayout {
+    enum Kind { case clockTower, statue, stairs, fountain, palace, gate }
+    struct Landmark {
+        let kind: Kind
+        let point: CGPoint
+        let scale: CGFloat
+        let right: Bool
+        let halfWidth: CGFloat
+        let rise: CGFloat
+    }
+    let scenery: WorldSceneryLayout
+    var scale: CGFloat { scenery.scale }
+
+    var landmarks: [Landmark] {
+        let plan: [(Kind, CGFloat, Bool, CGFloat, CGFloat, CGFloat)] = [
+            (.clockTower, 225, true, 53, 238, 1.02),
+            (.statue, 420, false, 62, 177, 1.02),
+            (.stairs, 590, false, 67, 172, 1.06),
+            (.fountain, 790, true, 67, 133, 1.12),
+            (.palace, 990, true, 88, 247, 0.98),
+            (.stairs, 1135, false, 67, 172, 1.02),
+            (.statue, 1310, false, 62, 177, 1.08),
+            (.fountain, 1510, false, 67, 133, 0.78),
+            (.gate, 1560, true, 90, 208, 0.86)
+        ]
+        return plan.map { kind, y, right, half, rise, factor in
+            let s = scale * factor
+            // The edge of every horizontal slice clears the complete 46pt
+            // trail and its level stones, even above an incoming bend.
+            var x: CGFloat = right ? 0 : scenery.width
+            for i in 0...32 {
+                let localY = -rise + (rise + 28) * CGFloat(i) / 32
+                let sampleY = y + localY * s
+                let roofTaper: CGFloat = localY < -rise * 0.68 ? 0.64 : 1
+                let boundary = scenery.centerX(at: sampleY) + (right ? 1 : -1) * (half * s * roofTaper + 53)
+                x = right ? max(x, boundary) : min(x, boundary)
+            }
+            return Landmark(kind: kind, point: CGPoint(x: x, y: y), scale: s, right: right,
+                            halfWidth: half, rise: rise)
+        }
+    }
+
+    func waterway(right: Bool) -> Path {
+        let start = -scenery.routeOffset
+        let end = scenery.height - scenery.routeOffset
+        return Path { path in
+            for i in 0...240 {
+                let y = start + (end - start) * CGFloat(i) / 240
+                let point = waterPoint(at: y, right: right)
+                if i == 0 { path.move(to: point) } else { path.addLine(to: point) }
+            }
+        }
+    }
+
+    func waterPoint(at y: CGFloat, right: Bool) -> CGPoint {
+        // Channels enter and leave through the side gardens, allowing
+        // both chapter boundaries to share uninterrupted stone ground.
+        let entry = min(1, max(0, (y - 5) / 170))
+        let exit = min(1, max(0, (1740 - y) / 155))
+        let blend = min(entry, exit), eased = blend * blend * (3 - 2 * blend)
+        let innerX = scenery.centerX(at: y) + (right ? 1 : -1) * 109 * scale
+        let outerX = right ? scenery.width + 70 * scale : -70 * scale
+        return CGPoint(x: outerX + (innerX - outerX) * eased, y: y)
+    }
+}
