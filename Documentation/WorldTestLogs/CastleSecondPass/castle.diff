+                    p.context.stroke(ring, with: .linearGradient(Gradient(colors: [Color(dinoHex: 0xAFCB7F), Color(dinoHex: 0x5A9854)]), startPoint: .init(x: x, y: back), endPoint: .init(x: x, y: front)), lineWidth: 7)
