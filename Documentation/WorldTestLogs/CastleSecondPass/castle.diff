+            p.hedge(from: .init(x: inner, y: back), to: .init(x: inner, y: entryY - 13), height: 10, width: 9)
+            if front > entryY + 13 { p.hedge(from: .init(x: inner, y: entryY + 13), to: .init(x: inner, y: front), height: 10, width: 9) }
