+/// Stable specimen geometry: changing the colour never selects a repeated bouquet.
+private enum CaveMineralFormation {
+    static func noise(_ seed: Int, _ channel: Int) -> CGFloat {
+        var value = UInt64(truncatingIfNeeded: seed &* 374_761_393 &+ channel &* 668_265_263)
+        value = (value ^ (value >> 13)) &* 1_274_126_177
+        value ^= value >> 16
+        return CGFloat(value & 0xFFFF) / 65535
+    }
+
+    struct Shard {
+        let root: CGPoint
+        let height: CGFloat
+        let width: CGFloat
+        let angle: Double
+        let cut: Int
+        let tint: Int
+        var highlight: CGPoint {
+            let radians = angle * .pi / 180
+            return CGPoint(x: root.x + sin(radians) * height * 0.63,
+                           y: root.y - cos(radians) * height * 0.63)
+        }
+    }
+
+    static func shards(_ seed: Int) -> [Shard] {
+        let kind = seed % 8
+        let count = [1, 2, 4, 3, 1, 6, 2, 3][kind]
+        let hue = Int(noise(seed, 7) * 4.99)
+        return (0..<count).map { i in
+            let n = noise(seed, 31 + i * 5), m = noise(seed, 32 + i * 5)
+            let x: CGFloat, y: CGFloat, height: CGFloat, angle: Double, width: CGFloat, cut: Int
+            switch kind {
+            case 0: // One long oblique prism, rooted in a narrow fissure.
+                x = -10; y = 5; height = 71 + n * 32; angle = Double(-36 + m * 62); width = 0.8 + n * 0.4; cut = 0
+            case 1: // Two broad, raw diamonds rather than a fan of needles.
+                x = CGFloat(i) * 31 - 16; y = CGFloat(i) * 8
+                height = 39 + n * 30; angle = Double(-28 + m * 68); width = 1.4 + m * 0.6; cut = 1
+            case 2: // A low seam of broken chips crossing the rock.
+                x = CGFloat(i) * 22 - 34; y = CGFloat(i) * -6 + 7
+                height = 18 + n * 30; angle = Double(30 + m * 44); width = 0.9 + m; cut = i % 2 + 2
+            case 3: // A rare tall outcrop, dominated by an off-centre prism.
+                x = CGFloat(i) * 25 - 23; y = m * 10
+                height = (i == 0 ? 96 : 33) + n * 20; angle = Double(-16 + CGFloat(i) * 17 + m * 12)
+                width = 0.7 + m * 0.7; cut = i == 2 ? 2 : 0
+            case 4: // A squat, wide crystal embedded halfway into the stone.
+                x = 4; y = 12; height = 55 + n * 20; angle = Double(-17 + m * 30); width = 2.1; cut = 1
+            case 5: // A druse of tiny crystals with a broken, uneven upper edge.
+                x = CGFloat(i) * 13 - 33; y = n * 17 - 2
+                height = 15 + m * 34; angle = Double(-35 + n * 86); width = 0.65 + m * 0.9; cut = i % 4
+            case 6: // Almost horizontal splinters projecting from a joint.
+                x = CGFloat(i) * 18 - 18; y = CGFloat(i) * 9
+                height = 51 + n * 24; angle = Double(48 + m * 29); width = 0.7 + m * 0.55; cut = i == 0 ? 3 : 0
+            default: // An irregular broken plate, flanked by two smaller shards.
+                x = CGFloat(i) * 26 - 23; y = m * 12
+                height = (i == 1 ? 68 : 22) + n * 21; angle = Double(-28 + m * 47)
+                width = i == 1 ? 1.6 : 0.8; cut = i == 1 ? 3 : 2
+            }
+            return Shard(root: CGPoint(x: x, y: y), height: height, width: width, angle: angle,
+                         cut: cut, tint: i == count - 1 && noise(seed, 19) > 0.74 ? (hue + 1) % 5 : hue)
+        }
+    }
+
+    static func highlight(_ seed: Int) -> CGPoint {
+        if seed % 8 == 1 || seed % 8 == 4 {
+            let height: CGFloat = (seed % 8 == 4 ? 68 : 39) + noise(seed, 3) * 12
+            return CGPoint(x: seed % 8 == 1 ? -15 : 0, y: -19 - height * 0.15)
+        }
+        return shards(seed).max(by: { $0.height < $1.height })!.highlight
+    }
+}
