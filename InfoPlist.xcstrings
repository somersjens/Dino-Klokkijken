    "NSGKFriendListUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the progress and stars of friends who allow Game Center access."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the progress and stars of friends who allow Game Center access."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض تقدّم ونجوم الأصدقاء الذين يسمحون بالوصول عبر Game Center."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh den Fortschritt und die Sterne von Freunden, die den Zugriff über Game Center erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the progress and stars of friends who allow Game Center access."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk de voortgang en sterren van vrienden die Game Center-toegang toestaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game Centerへのアクセスを許可した友だちの進み具合や集めた星を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示允许通过 Game Center 访问的好友的游戏进度和星星。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示允許透過 Game Center 取用的朋友的遊戲進度和星星。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת ההתקדמות והכוכבים של חברים שמאפשרים גישה ב־Game Center."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان دوستوں کی پیش رفت اور ستارے دکھائیں جو Game Center تک رسائی کی اجازت دیتے ہیں۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la progression et les étoiles des amis qui autorisent l’accès via Game Center."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la progression et les étoiles des amis qui autorisent l’accès dans Game Center."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el progreso y las estrellas de los amigos que dan permiso en Game Center."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o progresso e as estrelas dos amigos que autorizam o acesso através do Game Center."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o progresso e as estrelas dos amigos que permitem o acesso pelo Game Center."
          }
        },
