    "dino.friends.sharingDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: publish this device’s best level results, stars and progress to Game Center leaderboards under the Apple display name. Apple leaderboards may show these results to other players, not only friends. Your local name is never uploaded. Existing results from this Apple account are merged by taking the best result per level. Stopping sharing does not delete published results. This parental gate is not legal consent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel: publiceer de beste levelresultaten, sterren en voortgang van dit apparaat op Game Center-leaderboards onder de Apple-displaynaam. Apple-leaderboards kunnen deze resultaten aan andere spelers tonen, niet alleen aan vrienden. Je lokale naam wordt nooit verstuurd. Bestaande resultaten van dit Apple-account worden samengevoegd met het beste resultaat per level. Stoppen met delen verwijdert gepubliceerde resultaten niet. Dit ouderscherm is geen juridische toestemming."
          }
        }
      }
    },
