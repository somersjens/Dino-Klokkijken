    "dino.example.rule.sortTimes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن الساعات أولًا ثم الدقائق. اضغط على الأوقات الأربعة من الأسبق إلى الأحدث، ثم أكّد ترتيبك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche erst die Stunden, dann die Minuten. Tippe die Zeiten von früh bis spät an und bestätige."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk eerst de uren en daarna de minuten. Tik alle vier tijden van vroeg naar laat aan en bevestig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず時をくらべて、同じなら分をくらべよう。早い方から4つの時こくをタップして、答えを決めよう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先比小时，再比分钟。按从早到晚的顺序点选四个时刻，再确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先比小時，再比分鐘。從早到晚點選四個時刻，再確認。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משווים קודם את השעות, ואז את הדקות. בוחרים את כל ארבע השעות מהמוקדמת למאוחרת ומאשרים."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے گھنٹے دیکھو، پھر منٹ۔ چاروں وقت سب سے پہلے سے سب سے آخر تک چنو اور جواب پکا کرو۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare d’abord les heures, puis les minutes. Touche les quatre heures dans l’ordre de la journée, puis valide."
          }
        }
      }
    },
    "dino.example.rule.spokenTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بقول الساعة. «والربع» عند الدقيقة ١٥، و«والنصف» عند ٣٠، و«إلا ربعًا» قبل الساعة التالية بـ١٥ دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei „Viertel nach“ ist es :15. Bei „halb acht“ ist es 7:30. Bei „Viertel vor acht“ ist es 7:45."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek het uur in de zin. Kwart over is :15, half is :30 van het uur ervoor en kwart voor is :45 van het uur ervoor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず何時かを見よう。つぎに何分かを読もう。30分は「はん」とも言えるよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先找钟面上的小时，再从12开始数分钟。分针指到6时是30分，也可以读作“半”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先看時針剛過幾點，再從鐘面上的12開始數分鐘。分針指著6就是30分，也可以讀成「半」。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצאים את השעה במשפט. ״ורבע״ פירושו 15 דקות אחרי השעה, ״וחצי״ פירושו 30 דקות אחריה, ו״רבע ל…״ פירושו שנשארו 15 דקות לשעה הבאה."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوا یعنی 15 منٹ بعد، ساڑھے یعنی 30 منٹ بعد، اور پونے یعنی اگلے گھنٹے سے 15 منٹ پہلے۔ ڈیڑھ ایک بج کر تیس منٹ اور ڈھائی دو بج کر تیس منٹ ہیں۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis l’heure citée. « Et quart », c’est 15 minutes après. « Et demie », c’est 30 minutes après. « Moins le quart », c’est 15 minutes avant."
          }
        }
      }
    },
    "dino.example.rule.subtractTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرح المدة من وقت البداية. إذا تجاوزت ٠٠:٠٠ إلى الوراء، فأكمل في اليوم السابق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die angegebene Dauer von der Startzeit ab. Vor 00:00 Uhr geht es am Vortag weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek de duur van de begintijd af. Vóór 00:00 reken je verder op de vorige dag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はじめの時こくから、きめられた時間を引こう。0時より前は前の日だよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从开始时刻往回数。早于00:00时，接着往前一天数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從開始時刻往回數。早於00:00時，接著往前一天數。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחסירים את משך הזמן משעת ההתחלה. לפני 00:00 חוזרים ליום הקודם."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع کے وقت سے دورانیہ گھٹاؤ۔ 00:00 سے پہلے کا وقت پچھلے دن میں آتا ہے۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soustrais la durée de l’heure de départ. Avant 00:00, tu reviens à la veille."
          }
        }
      }
    },
    "dino.example.rule.timeSequence" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوجد الفاصل نفسه بين كل وقت والذي يليه، ثم أضفه إلى آخر وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde den gleichen Abstand zwischen den Uhrzeiten. Zähle ihn zur letzten Uhrzeit dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek de gelijke stap tussen de tijden. Tel die stap nog één keer bij de laatste tijd op."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時こくが何分ずつ進むか見つけよう。同じ時間を最後の時こくに足してね。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出相邻时刻之间相差的时间，再从最后一个时刻往后数这么久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出相鄰時刻之間相差的時間，再從最後一個時刻往後數這麼久。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגלים בכמה זמן גדלה כל שעה ברצף. מוסיפים אותו פרק זמן לשעה האחרונה."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیکھو ہر بار وقت کتنا آگے بڑھتا ہے۔ آخری وقت میں اتنا ہی دورانیہ ایک بار اور جمع کرو۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve l’écart qui se répète. Ajoute-le une fois de plus à la dernière heure."
          }
        }
      }
    },
    "dino.example.rule.timeZone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم فرق الوقت المعطى. أضِف الفرق إذا كان وقت المدينة الثانية متقدّمًا، واطرحه إذا كان متأخّرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den angegebenen Zeitunterschied. Ist es in der anderen Stadt später, zählst du die Zeit dazu. Ist es früher, ziehst du sie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het gegeven verschil: tel uren op als stad B later is en trek uren af als stad B eerder is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都市Bの方が進んでいれば時差を足し、おくれていれば時差を引こう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城市B的时刻更晚就加上时差，更早就减去时差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城市B的時間比城市A晚，就加上時差。比城市A早，就減去時差。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמשים בהפרש הנתון. מוסיפים זמן אם השעה בעיר ב׳ מאוחרת יותר, ומחסירים זמן אם היא מוקדמת יותר."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیا گیا فرق استعمال کرو۔ دوسرے شہر کا وقت آگے ہو تو فرق جمع کرو، پیچھے ہو تو گھٹاؤ۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le décalage indiqué. Ajoute des heures si la ville B est en avance, retire-en si elle est en retard."
          }
        }
      }
    },
    "dino.example.rule.trueFalse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
