    "dino.example.rule.read24Hour" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract 12 from an hour above 12 to read the clock in words. Keep its part of day. 00:00 is twelve at night."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For hours above 12, subtract 12. For example, 17:05 is 5:05 pm. 12:00 is midday and 00:00 is midnight."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان رقم الساعات أكبر من ١٢، فاطرح ١٢ منه وأبقِ الدقائق كما هي. مثلًا: ١٧:٠٥ تصبح ٥:٠٥ م. ١٢:٠٠ ظهرًا و٠٠:٠٠ منتصف الليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies erst die Stunden und dann die Minuten. Bei 17:05 sagst du „siebzehn Uhr fünf“. Um 00:00 Uhr ist Mitternacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract 12 from an hour above 12 to read the clock in words. Keep its part of day. 00:00 is twelve at night."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een uur boven 12 trek je 12 af om de tijd in woorden te lezen. Houd rekening met het dagdeel. 00:00 is twaalf uur ’s nachts."
          }
        }
      }
    },
    "dino.example.rule.readDigital" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
