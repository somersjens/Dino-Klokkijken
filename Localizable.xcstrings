        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ العقارب وقل الوقت بالكلمات. الألوان تجمع العبارات التي تُقرأ بالطريقة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
