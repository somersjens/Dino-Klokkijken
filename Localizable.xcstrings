    "dino.question.daySchedule.format" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The train leaves at %@. Add %@, %@ and %@. What time does it arrive?"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The train leaves at %@. Add %@, %@ and %@. What time does it arrive?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغادر القطار عند %1$@. اجمع هذه المدد: %2$@، %3$@، %4$@. متى يصل؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zug fährt um %1$@ ab. Zähle %2$@, %3$@ und %4$@ dazu. Wann kommt er an?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The train leaves at %@. Add %@, %@ and %@. What time does it arrive?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De trein vertrekt om %@. Tel %@, %@ en %@ erbij. Hoe laat komt hij aan?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電車は%1$@に出発します。%2$@、%3$@、%4$@を足すと、何時に着くかな？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火车%1$@出发。加上%2$@、%3$@和%4$@，几点到？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火車%1$@出發。加上%2$@、%3$@和%4$@，幾點到？"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרכבת יוצאת בשעה %1$@. מוסיפים %2$@, %3$@ וגם %4$@. באיזו שעה הרכבת מגיעה?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹرین کی روانگی کا وقت %1$@ ہے۔ %2$@، %3$@ اور %4$@ جمع کرو۔ ٹرین کتنے بجے پہنچے گی؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le train part à %1$@. Ajoute %2$@, %3$@ et %4$@. À quelle heure arrive-t-il ?"
          }
        }
      }
    },
