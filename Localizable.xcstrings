          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من الوقت الظاهر. حرّك عقربَي الساعات والدقائق إلى الأمام بمقدار المدة، ثم أكّد إجابتك."
          }
