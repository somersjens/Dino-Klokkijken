    "dino.example.rule.addTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel de duur bij de begintijd op. Elke 60 minuten is een uur erbij. Na 23:59 komt 00:00."
          }
        }
      }
    },
    "dino.example.rule.advanceAnalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with the clock shown. Move its hour and minute hands forward by the given duration, then confirm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin bij de getoonde klok. Zet de uur- en minutenwijzer de gegeven tijd vooruit en bevestig."
          }
        }
      }
    },
    "dino.example.rule.dayPart" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night: 00:00–05:59. Morning: 06:00–11:59. Afternoon: 12:00–17:59. Evening: 18:00–23:59."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacht: 00:00–05:59. Ochtend: 06:00–11:59. Middag: 12:00–17:59. Avond: 18:00–23:59."
          }
        }
      }
    },
    "dino.example.rule.flightArrival" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the flight duration to the departure time. These times use the same time zone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel de vluchtduur bij de vertrektijd op. Deze tijden gebruiken dezelfde tijdzone."
          }
        }
      }
    },
    "dino.example.rule.read24Hour" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract 12 from an hour above 12 to read the clock in words. Keep its part of day. 00:00 is twelve at night."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een uur boven 12 trek je 12 af om de tijd in woorden te lezen. Houd rekening met het dagdeel. 00:00 is twaalf uur ’s nachts."
          }
        }
      }
    },
    "dino.example.rule.readDigital" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the hours before the colon and the minutes after it. Then say the time in words."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de uren vóór de dubbele punt en de minuten erna. Zeg de tijd daarna in woorden."
          }
        }
      }
    },
    "dino.example.rule.sortTimes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk eerst de uren en daarna de minuten. Tik alle vier tijden van vroeg naar laat aan en bevestig."
          }
        }
      }
    },
    "dino.example.rule.spokenTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek het uur in de zin. Kwart over is :15, half is :30 van het uur ervoor en kwart voor is :45 van het uur ervoor."
          }
        }
      }
    },
    "dino.example.rule.subtractTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek de duur van de begintijd af. Vóór 00:00 reken je verder op de vorige dag."
          }
        }
      }
    },
    "dino.example.rule.timeSequence" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek de gelijke stap tussen de tijden. Tel die stap nog één keer bij de laatste tijd op."
          }
        }
      }
    },
    "dino.example.rule.timeZone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het gegeven verschil: tel uren op als stad B later is en trek uren af als stad B eerder is."
          }
        }
      }
    },
    "dino.example.rule.trueFalse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the short hour hand and the long minute hand. Choose True only when the sentence describes the same time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de korte uurwijzer en de lange minutenwijzer af. Kies Goed als de zin dezelfde tijd beschrijft."
          }
        }
      }
    },
