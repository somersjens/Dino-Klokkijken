    "dino.settings.dayParts.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط بداية كل فترة من اليوم ونهايتها. عند نهاية فترة تبدأ الفترة التالية. تُقيّم الإجابات بحسب هذه الأوقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wann jede Tageszeit beginnt und endet. Eine Tageszeit endet dann, wenn die nächste beginnt. Das Spiel prüft deine Antworten anhand dieser Zeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel in van hoe laat tot hoe laat elk dagdeel duurt. Het einde van het ene dagdeel is het begin van het volgende. Vragen rekenen goed of fout met deze tijden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれの時間帯が始まる時こくと終わる時こくを決めます。ある時間帯の終わりが、つぎの時間帯の始まりです。問題の答え合わせには、ここで決めた時こくを使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定每个时段的开始和结束时刻。一个时段结束，下一个时段就开始。游戏会按这些时刻判断答案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定每個時段的開始和結束時間。前一個時段結束時，下一個時段就開始。遊戲會依這些時段判斷答案。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לקבוע מתי כל חלק ביממה מתחיל ומסתיים. כשחלק אחד מסתיים, הבא אחריו מתחיל. התשובות נבדקות לפי השעות שנקבעו כאן."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طے کرو کہ دن کا ہر حصہ کب شروع اور کب ختم ہوتا ہے۔ جہاں ایک حصہ ختم ہوتا ہے، وہیں اگلا شروع ہوتا ہے۔ جواب انہی اوقات کے مطابق جانچے جائیں گے۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle le début et la fin de chaque moment de la journée. La fin de l’un marque le début du suivant. Ces horaires servent à vérifier tes réponses."
          }
        }
      }
    },
