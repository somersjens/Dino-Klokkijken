    "dino.settings.dayParts.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط بداية كل فترة من اليوم ونهايتها. عند نهاية فترة تبدأ الفترة التالية. تُقيّم الإجابات بحسب هذه الأوقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wann jede Tageszeit beginnt und endet. Eine Tageszeit endet dann, wenn die nächste beginnt. Das Spiel prüft deine Antworten anhand dieser Zeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each part of the day starts and ends. The end of one part is the start of the next. Questions are marked right or wrong with these times."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel in van hoe laat tot hoe laat elk dagdeel duurt. Het einde van het ene dagdeel is het begin van het volgende. Vragen rekenen goed of fout met deze tijden."
          }
        }
      }
    },
