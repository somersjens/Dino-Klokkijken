    "dino.friends.scoreInfoMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off to let friends see only your level in this game. Your stars and times will be hidden. Apple keeps results previously published in Game Center; older versions of the game may still show them."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off to let friends see only your level in this game. Your stars and times will be hidden. Apple keeps results previously published in Game Center; older versions of the game may still show them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف هذا الخيار حتى يرى أصدقاؤك مستواك فقط في اللعبة. ستختفي نجومك وأوقاتك. تحتفظ Apple بالنتائج التي نُشرت سابقًا في Game Center، وقد تظل ظاهرة في الإصدارات الأقدم من اللعبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das ausschaltest, sehen deine Freunde in diesem Spiel nur dein Level. Sterne und Zeiten werden ausgeblendet. Apple behält bereits in Game Center veröffentlichte Ergebnisse. Ältere Spielversionen können sie weiterhin anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off to let friends see only your level in this game. Your stars and times will be hidden. Apple keeps results previously published in Game Center; older versions of the game may still show them."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet dit uit zodat vrienden in dit spel alleen je level zien. Je sterren en tijden zijn dan verborgen. Apple bewaart eerder gepubliceerde Game Center-resultaten; oudere versies van het spel kunnen die nog tonen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、このゲームで友だちに見えるのはレベルだけです。星と時間は非表示になります。Game Centerで公開済みの結果はAppleに保存され、ゲームの古いバージョンでは表示されることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，好友在此版本只能看到你的关卡进度，星星和用时会隐藏。Apple 会保留已发布到 Game Center 的成绩，旧版游戏仍可能显示这些成绩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，朋友在此版本只能看到你的關卡進度，星星和遊玩時間會隱藏。Apple 會保留已發布到 Game Center 的成績，舊版遊戲仍可能顯示這些成績。"
          }
        }
      }
    },
