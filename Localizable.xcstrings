        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوئیاں دیکھو اور وقت لفظوں میں بتاؤ۔ ایک جیسے رنگوں والے وقت ایک ہی طرح بولے جاتے ہیں۔"
          }
        },
