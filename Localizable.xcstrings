        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب قدر ما تشاء. التدريب لا يغيّر عدد نجومك ولا تقدّمك في المستويات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe so lange du magst. Deine Sterne und dein Levelfortschritt bleiben dabei gleich."
