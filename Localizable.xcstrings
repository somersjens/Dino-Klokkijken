          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de wijzers en zeg de tijd in woorden. De kleuren groeperen tijden die je op dezelfde manier zegt."
          }
        },
        "ja" : {
          "stringUnit" : {
