    "dino.example.rule.read24Hour" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract 12 from an hour above 12 to read the clock in words. Keep its part of day. 00:00 is twelve at night."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For hours above 12, subtract 12. For example, 17:05 is 5:05 pm. 12:00 is midday and 00:00 is midnight."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان رقم الساعات أكبر من ١٢، فاطرح ١٢ منه وأبقِ الدقائق كما هي. مثلًا: ١٧:٠٥ تصبح ٥:٠٥ م. ١٢:٠٠ ظهرًا و٠٠:٠٠ منتصف الليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies erst die Stunden und dann die Minuten. Bei 17:05 sagst du „siebzehn Uhr fünf“. Um 00:00 Uhr ist Mitternacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract 12 from an hour above 12 to read the clock in words. Keep its part of day. 00:00 is twelve at night."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een uur boven 12 trek je 12 af om de tijd in woorden te lezen. Houd rekening met het dagdeel. 00:00 is twaalf uur ’s nachts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24時間の時計では、時の数をそのまま読もう。17:05は「じゅうしちじごふん」。0:00は「れいじ」だよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用24时计时法读出完整的小时数和分钟数。00:00读作零点，17:05读作十七点零五分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用24小時制讀出完整的小時和分鐘。00:00讀作零點，17:05讀作十七點零五分。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בשעון של 24 שעות קוראים את שעת היממה המלאה. כדי לעבור לשעון של 12 שעות מחסירים 12 משעה שגדולה מ־12. 00:00 היא חצות."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر گھنٹا 12 سے بڑا ہو تو اس میں سے 12 گھٹاؤ۔ دن کا حصہ وہی رہتا ہے۔ 00:00 رات کے بارہ بجے ہیں۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis le nombre d’heures affiché, puis les minutes. 00:00 se dit minuit et 12:00 se dit midi."
          }
        }
      }
    },
    "dino.example.rule.readDigital" : {
      "extractionState" : "manual",
      "localizations" : {
