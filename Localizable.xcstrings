    "dino.example.rule.addTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المدة إلى وقت البداية. كل ٦٠ دقيقة تساوي ساعة. بعد ٢٣:٥٩ يأتي ٠٠:٠٠."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle die Dauer zur Startzeit dazu. 60 Minuten ergeben eine Stunde. Nach 23:59 kommt 00:00 Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel de duur bij de begintijd op. Elke 60 minuten is een uur erbij. Na 23:59 komt 00:00."
          }
        }
      }
    },
    "dino.example.rule.advanceAnalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
