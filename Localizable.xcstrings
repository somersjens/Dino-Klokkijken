    "dino.settings.icloudDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your progress between iPhone and iPad using the same iCloud account. Enable iCloud sync on both devices."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je voortgang tussen iPhone en iPad met hetzelfde iCloud-account. Zet iCloud-sync op beide apparaten aan."
          }
        }
      }
    },
    "dino.settings.icloud.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Your progress is saved only on this device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit. Je voortgang wordt alleen op dit apparaat bewaard."
          }
        }
      }
    },
    "dino.settings.icloud.active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On. Sign in to the same iCloud account on both devices. Updating may take a little time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan. Log op beide apparaten in met hetzelfde iCloud-account. Het bijwerken kan even duren."
          }
        }
      }
    },
    "dino.settings.icloud.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is temporarily unavailable. Your progress stays saved locally; we will try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is tijdelijk niet beschikbaar. Je voortgang blijft lokaal bewaard; we proberen het later opnieuw."
          }
        }
      }
    },
    "dino.settings.icloudResetMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is on. Progress will also reset on your other devices with iCloud sync enabled."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-sync staat aan. De voortgang wordt ook gereset op je andere apparaten waarop iCloud-sync aanstaat."
          }
        }
      }
