    "dino.practice.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep practising for as long as you like. Practice does not change your stars or level progress."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep practising for as long as you like. Practice does not change your stars or level progress."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب قدر ما تشاء. التدريب لا يغيّر عدد نجومك ولا تقدّمك في المستويات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe so lange du magst. Deine Sterne und dein Levelfortschritt bleiben dabei gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep practicing for as long as you like. Practice does not change your stars or level progress."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oefen zo lang als je wilt. Oefenen verandert je sterren en levelvoortgang niet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなだけれんしゅうできるよ。集めた星やレベルの進み具合にはえいきょうしないよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想练多久都可以。练习不会影响你的星星和关卡进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想練多久都可以。練習不會影響你的星星和關卡進度。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לתרגל כמה שרוצים. התרגול לא משנה את הכוכבים או את ההתקדמות בשלבים."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جتنی دیر چاہو مشق کرو۔ مشق سے تمہارے ستارے اور مرحلوں کی پیش رفت نہیں بدلتی۔"
