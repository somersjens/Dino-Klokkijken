      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze lokale opslag was gekoppeld aan een ander Game Center-account. Delen is gepauzeerd om die speler te beschermen. Keer terug naar dat account of reset de lokale voortgang voordat je een nieuw account koppelt."
          }
        }
      }
    },
    "dino.friends.sharingRestricted": {
      "extractionState": "manual",
      "localizations": {
