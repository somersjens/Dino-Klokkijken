    "dino.resetMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress, colours, clocks, language and settings on this device will be erased. Saved iCloud progress is erased too. Game Center best scores and earned achievements stay with Apple. Sharing them again can restore previous best results."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress, colours, clocks, language and settings on this device will be erased. Saved iCloud progress is erased too. Game Center best scores and earned achievements stay with Apple. Sharing them again can restore previous best results."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُمحى التقدّم والألوان والساعات واللغة والإعدادات من هذا الجهاز، ويُمحى التقدّم المحفوظ في iCloud أيضًا. تحتفظ Apple بأفضل النتائج والإنجازات المكتسبة في Game Center. قد يعيد استئناف المشاركة إظهار أفضل نتائجك السابقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt, Farben, Uhren, Sprache und Einstellungen werden auf diesem Gerät gelöscht. Auch der in iCloud gespeicherte Spielstand wird gelöscht. Bestleistungen und Erfolge in Game Center bleiben bei Apple gespeichert. Wenn du das Teilen erneut einschaltest, können frühere Bestleistungen wieder angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress, colors, clocks, language and settings on this device will be erased. Saved iCloud progress is erased too. Game Center best scores and earned achievements stay with Apple. Sharing them again can restore previous best results."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voortgang, kleuren, klokken, taal en instellingen op dit apparaat worden gewist. Ook de opgeslagen iCloud-voortgang wordt gewist. Beste Game Center-scores en behaalde prestaties blijven bij Apple. Opnieuw delen kan eerdere beste resultaten herstellen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の進み具合、色、時計、言語、設定が消去されます。iCloudに保存した進み具合も消去されます。Game Centerの最高スコアと達成した項目はAppleに残ります。もう一度共有すると、以前の最高記録が復元されることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的进度、配色、时钟、语言和设置将被清除，iCloud 中保存的进度也会被清除。Game Center 的最佳成绩和已获成就仍由 Apple 保留。再次分享时，之前的最佳成绩可能会恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的進度、配色、時鐘、語言和設定將被清除，iCloud 中儲存的進度也會被清除。Game Center 的最佳成績和已獲成就仍由 Apple 保留。再次分享時，之前的最佳成績可能會恢復。"
          }
        }
      }
    },
