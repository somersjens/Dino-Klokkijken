          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the short hour hand and the long minute hand. Choose True only when the sentence describes the same time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de korte uurwijzer en de lange minutenwijzer af. Kies Goed als de zin dezelfde tijd beschrijft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短いはりで時を、長いはりで分を読もう。書いてある時こくと同じなら「はい」をえらんでね。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先看短时针，再看长分针。句子和钟面表示同一时刻时，选“对”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先看短時針，再看長分針。句子和鐘面表示同一時刻時，選「對」。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוראים את מחוג השעות הקצר ואת מחוג הדקות הארוך. בוחרים ״נכון״ רק אם המשפט מתאר את השעה שבשעון."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھنٹے کی چھوٹی سوئی اور منٹ کی بڑی سوئی دیکھو۔ جملے اور گھڑی کا وقت ایک ہو تو درست چنو۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis la petite aiguille des heures et la grande aiguille des minutes. Choisis « Vrai » si la phrase indique la même heure."
          }
        }
      }
