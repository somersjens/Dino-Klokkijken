    "dino.friends.reportHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To report an inappropriate name or avatar, or remove a friend, open their profile in Apple Games and choose Report User or Remove Friend. For further blocking options, use Apple account and Screen Time settings."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To report an inappropriate name or avatar, or remove a friend, open their profile in Apple Games and choose Report User or Remove Friend. For further blocking options, use Apple account and Screen Time settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للإبلاغ عن اسم أو صورة رمزية غير مناسبة، أو لإزالة صديق، افتح ملفه في تطبيق ألعاب Apple واختر «الإبلاغ عن المستخدم» أو «إزالة الصديق». لمزيد من خيارات الحظر، استخدم إعدادات حساب Apple و«مدة استخدام الجهاز»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen unangemessenen Namen oder ein Profilbild melden oder jemanden entfernen möchtest, öffne das Profil in Apple Games und wähle „Benutzer melden“ oder „Freund entfernen“. Weitere Möglichkeiten zum Blockieren findest du in den Apple-Account- und Bildschirmzeit-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To report an inappropriate name or avatar, or remove a friend, open their profile in Apple Games and choose Report User or Remove Friend. For further blocking options, use Apple account and Screen Time settings."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open voor het melden van een ongepaste naam of avatar, of het verwijderen van een vriend, het profiel in Apple Games en kies Meld gebruiker of Verwijder vriend. Gebruik voor verdere blokkeringen je Apple-account en Schermtijdinstellingen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不適切な名前やアバターを報告したり、友だちを削除したりするには、Apple Gamesで相手のプロフィールを開き、「ユーザを報告」または「友達を削除」を選んでください。ほかのブロック設定は、Appleアカウントとスクリーンタイムの設定で行えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要举报不当名称或头像，或删除好友，请在 Apple Games 中打开对方的个人资料，选择“举报用户”或“移除好友”。更多屏蔽选项可在 Apple 账户和“屏幕使用时间”设置中找到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要檢舉不當的名稱或頭像，或移除朋友，請在 Apple Games 開啟對方的個人檔案，再選擇「檢舉使用者」或「移除朋友」。你也可以在 Apple 帳號和「螢幕使用時間」設定中找到更多封鎖選項。"
          }
        }
      }
    },
