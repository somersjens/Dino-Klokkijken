    "dino.example.rule.addTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المدة إلى وقت البداية. كل ٦٠ دقيقة تساوي ساعة. بعد ٢٣:٥٩ يأتي ٠٠:٠٠."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle die Dauer zur Startzeit dazu. 60 Minuten ergeben eine Stunde. Nach 23:59 kommt 00:00 Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the duration to the start time. Every 60 minutes makes another hour. After 23:59 comes 00:00."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel de duur bij de begintijd op. Elke 60 minuten is een uur erbij. Na 23:59 komt 00:00."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はじめの時こくに、たった時間を足そう。60分で1時間。23時59分の次は0時だよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从开始时刻往后数。满60分钟就是1小时。23:59过后是第二天的00:00。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從開始的時刻往後數。每60分鐘是1小時。23:59過後就是隔天的00:00。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיפים את משך הזמן לשעת ההתחלה. כל 60 דקות הן עוד שעה. אחרי 23:59 מגיעה 00:00."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع کے وقت میں دیا گیا دورانیہ جمع کرو۔ ہر 60 منٹ کا ایک گھنٹہ بنتا ہے۔ 23:59 کے بعد 00:00 آتا ہے۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la durée à l’heure de départ. Toutes les 60 minutes, ajoute une heure. Après 23:59, il est 00:00 le lendemain."
          }
        }
      }
    },
    "dino.example.rule.advanceAnalog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
