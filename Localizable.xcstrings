    "dino.friends.parentMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This opens Apple’s social features or asks for friends access. An adult can continue below. Apple’s account restrictions still apply."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This opens Apple’s social features or asks for friends access. An adult can continue below. Apple’s account restrictions still apply."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح هذا ميزات Apple الاجتماعية أو يطلب الوصول إلى الأصدقاء. يمكن لشخص بالغ المتابعة أدناه. تظل قيود الحساب لدى Apple سارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit öffnest du Apples soziale Funktionen oder fragst den Zugriff auf die Freundesliste an. Ein Erwachsener kann unten fortfahren. Apples Account-Beschränkungen gelten weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This opens Apple’s social features or asks for friends access. An adult can continue below. Apple’s account restrictions still apply."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit opent Apples sociale functies of vraagt om vriendentoegang. Een volwassene kan hieronder doorgaan. De beperkingen van het Apple-account blijven gelden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのソーシャル機能を開くか、友だちリストへのアクセス許可を求めます。保護者の方は下からお進みください。Appleアカウントの制限は引き続き適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续后将打开 Apple 的社交功能或请求访问好友列表。请由成年人在下方继续。Apple 的账户限制仍然适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繼續後會開啟 Apple 的社群功能或要求取用朋友列表。請由成年人在下方繼續操作。Apple 的帳號限制仍然適用。"
          }
        }
      }
    },
