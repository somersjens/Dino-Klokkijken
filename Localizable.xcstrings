        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن الساعات أولًا ثم الدقائق. اضغط على الأوقات الأربعة من الأسبق إلى الأحدث، ثم أكّد ترتيبك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche erst die Stunden, dann die Minuten. Tippe die Zeiten von früh bis spät an und bestätige."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk eerst de uren en daarna de minuten. Tik alle vier tijden van vroeg naar laat aan en bevestig."
          }
        }
      }
    },
    "dino.example.rule.spokenTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بقول الساعة. «والربع» عند الدقيقة ١٥، و«والنصف» عند ٣٠، و«إلا ربعًا» قبل الساعة التالية بـ١٥ دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei „Viertel nach“ ist es :15. Bei „halb acht“ ist es 7:30. Bei „Viertel vor acht“ ist es 7:45."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek het uur in de zin. Kwart over is :15, half is :30 van het uur ervoor en kwart voor is :45 van het uur ervoor."
          }
        }
      }
    },
    "dino.example.rule.subtractTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرح المدة من وقت البداية. إذا تجاوزت ٠٠:٠٠ إلى الوراء، فأكمل في اليوم السابق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die angegebene Dauer von der Startzeit ab. Vor 00:00 Uhr geht es am Vortag weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek de duur van de begintijd af. Vóór 00:00 reken je verder op de vorige dag."
          }
        }
      }
    },
    "dino.example.rule.timeSequence" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوجد الفاصل نفسه بين كل وقت والذي يليه، ثم أضفه إلى آخر وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde den gleichen Abstand zwischen den Uhrzeiten. Zähle ihn zur letzten Uhrzeit dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek de gelijke stap tussen de tijden. Tel die stap nog één keer bij de laatste tijd op."
          }
        }
      }
    },
    "dino.example.rule.timeZone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم فرق الوقت المعطى. أضِف الفرق إذا كان وقت المدينة الثانية متقدّمًا، واطرحه إذا كان متأخّرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den angegebenen Zeitunterschied. Ist es in der anderen Stadt später, zählst du die Zeit dazu. Ist es früher, ziehst du sie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het gegeven verschil: tel uren op als stad B later is en trek uren af als stad B eerder is."
          }
        }
      }
    },
