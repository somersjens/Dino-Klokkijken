    "dino.example.rule.sortTimes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن الساعات أولًا ثم الدقائق. اضغط على الأوقات الأربعة من الأسبق إلى الأحدث، ثم أكّد ترتيبك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche erst die Stunden, dann die Minuten. Tippe die Zeiten von früh bis spät an und bestätige."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the hours first, then the minutes. Tap all four times from earliest to latest and confirm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk eerst de uren en daarna de minuten. Tik alle vier tijden van vroeg naar laat aan en bevestig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず時をくらべて、同じなら分をくらべよう。早い方から4つの時こくをタップして、答えを決めよう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先比小时，再比分钟。按从早到晚的顺序点选四个时刻，再确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先比小時，再比分鐘。從早到晚點選四個時刻，再確認。"
          }
        }
      }
    },
    "dino.example.rule.spokenTime" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بقول الساعة. «والربع» عند الدقيقة ١٥، و«والنصف» عند ٣٠، و«إلا ربعًا» قبل الساعة التالية بـ١٥ دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei „Viertel nach“ ist es :15. Bei „halb acht“ ist es 7:30. Bei „Viertel vor acht“ ist es 7:45."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the hour in the sentence. Quarter past is :15, half past is :30 and quarter to is :45."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek het uur in de zin. Kwart over is :15, half is :30 van het uur ervoor en kwart voor is :45 van het uur ervoor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず何時かを見よう。つぎに何分かを読もう。30分は「はん」とも言えるよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先找钟面上的小时，再从12开始数分钟。分针指到6时是30分，也可以读作“半”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先看時針剛過幾點，再從鐘面上的12開始數分鐘。分針指著6就是30分，也可以讀成「半」。"
          }
        }
      }
    },
