    "dino.friends.stopSharingMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This hides your stars and times in this game and stops new score uploads. Your level and boss achievements still update. Apple keeps previously published results and achievements; older game versions may still show scores."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This hides your stars and times in this game and stops new score uploads. Your level and boss achievements still update. Apple keeps previously published results and achievements; older game versions may still show scores."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخفي هذا الخيار نجومك وأوقاتك في اللعبة، ويوقف إرسال النتائج الجديدة. يستمر تحديث مستواك وإنجازات الزعماء. تحتفظ Apple بالنتائج والإنجازات المنشورة سابقًا، وقد تظل النتائج ظاهرة في الإصدارات الأقدم من اللعبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sterne und Zeiten werden in diesem Spiel ausgeblendet. Neue Ergebnisse werden nicht mehr gesendet. Erfolge für Level und Bosse werden weiter aktualisiert. Apple behält bereits veröffentlichte Ergebnisse und Erfolge. Ältere Spielversionen können Ergebnisse weiterhin anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This hides your stars and times in this game and stops new score uploads. Your level and boss achievements still update. Apple keeps previously published results and achievements; older game versions may still show scores."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verbergt je sterren en tijden in dit spel en stopt nieuwe score-uploads. Je level en baasprestaties blijven bijgewerkt. Apple bewaart eerder gepubliceerde resultaten en prestaties; oudere spelversies kunnen scores nog tonen."
          }
        }
      }
    },
