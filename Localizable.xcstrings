          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtract the duration from the start time. Before 00:00, continue on the previous day."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek de duur van de begintijd af. Vóór 00:00 reken je verder op de vorige dag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はじめの時こくから、きめられた時間を引こう。0時より前は前の日だよ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从开始时刻往回数。早于00:00时，接着往前一天数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從開始時刻往回數。早於00:00時，接著往前一天數。"
          }
        }
      }
    },
    "dino.example.rule.timeSequence" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوجد الفاصل نفسه بين كل وقت والذي يليه، ثم أضفه إلى آخر وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde den gleichen Abstand zwischen den Uhrzeiten. Zähle ihn zur letzten Uhrzeit dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the equal step between times. Add that step once more to the last time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek de gelijke stap tussen de tijden. Tel die stap nog één keer bij de laatste tijd op."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時こくが何分ずつ進むか見つけよう。同じ時間を最後の時こくに足してね。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出相邻时刻之间相差的时间，再从最后一个时刻往后数这么久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出相鄰時刻之間相差的時間，再從最後一個時刻往後數這麼久。"
          }
        }
      }
    },
    "dino.example.rule.timeZone" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم فرق الوقت المعطى. أضِف الفرق إذا كان وقت المدينة الثانية متقدّمًا، واطرحه إذا كان متأخّرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den angegebenen Zeitunterschied. Ist es in der anderen Stadt später, zählst du die Zeit dazu. Ist es früher, ziehst du sie ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stated difference: add hours when city B is later; subtract hours when it is earlier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het gegeven verschil: tel uren op als stad B later is en trek uren af als stad B eerder is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都市Bの方が進んでいれば時差を足し、おくれていれば時差を引こう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城市B的时刻更晚就加上时差，更早就减去时差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城市B的時間比城市A晚，就加上時差。比城市A早，就減去時差。"
          }
        }
      }
    },
