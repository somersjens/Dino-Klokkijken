    "dino.settings.icloudDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn sync on to save your progress in iCloud and keep playing on other devices. If it's off, your progress stays only on this device and you can lose it if you lose the device."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn sync on to save your progress in iCloud and keep playing on other devices. If it's off, your progress stays only on this device and you can lose it if you lose the device."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل المزامنة لحفظ تقدّمك في iCloud ومواصلة اللعب على أجهزة أخرى. إذا أوقفتها، يبقى التقدّم على هذا الجهاز فقط وقد تفقده إذا فقدت الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Synchronisierung ein, um deinen Fortschritt in iCloud zu sichern und auf anderen Geräten weiterzuspielen. Ist sie aus, bleibt dein Fortschritt nur auf diesem Gerät. Wenn du das Gerät verlierst, kannst du auch den Spielstand verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn sync on to save your progress in iCloud and keep playing on other devices. If it's off, your progress stays only on this device and you can lose it if you lose the device."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet synchronisatie aan om je voortgang in iCloud te bewaren en op andere apparaten verder te spelen. Staat het uit? Dan blijft je voortgang alleen op dit apparaat en kun je die kwijtraken als je het apparaat verliest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期をオンにすると、進み具合をiCloudに保存し、ほかの端末でも続きから遊べます。オフのときはこの端末にだけ保存されるので、端末をなくすと記録が失われることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启同步后，进度会存到 iCloud，你可以在其他设备上继续玩。关闭时，进度只保存在这台设备上，设备丢失可能导致进度丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟同步後，進度會儲存到 iCloud，讓你在其他裝置上繼續玩。關閉時，進度只會儲存在這台裝置。裝置遺失時，進度也可能遺失。"
          }
        }
      }
    },
