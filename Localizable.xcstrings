    "dino.friends.signOutMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect Game Center from Dino Time. To sign out on this device, go to Settings → Game Center → Sign Out."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect Game Center from Dino Time. To sign out on this device, go to Settings → Game Center → Sign Out."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افصل Game Center عن دينو والوقت. للخروج من الحساب على هذا الجهاز، افتح الإعدادات، ثم Game Center، ثم اختر «تسجيل الخروج»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne Game Center von Dino-Zeit. Um dich auf dem Gerät abzumelden, gehe zu Einstellungen → Game Center → Abmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect Game Center from Dino Time. To sign out on this device, go to Settings → Game Center → Sign Out."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel Game Center los van Dino Klokkijken. Wil je afmelden op dit apparaat? Ga naar Instellingen → Game Center → Log uit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディノのとけいとGame Centerの連携を解除します。この端末でサインアウトするには「設定」→「Game Center」→「サインアウト」に進んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开《恐龙学看钟》与 Game Center 的连接。如需在此设备上退出，请前往“设置”→“Game Center”→“退出登录”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "《恐龍學看鐘》會中斷 Game Center 連線。如要在這台裝置上登出，請前往「設定」→「Game Center」→「登出」。"
          }
        }
      }
    },
