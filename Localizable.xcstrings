          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ عقرب الساعات القصير وعقرب الدقائق الطويل. اختر «صحيح» إذا وصفت العبارة الوقت نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
