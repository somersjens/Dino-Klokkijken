    "dino.friends.accountConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان هذا الحفظ على الجهاز مرتبطًا بحساب آخر في Game Center. توقفت المشاركة لحماية ذلك اللاعب. عُد إلى الحساب السابق أو أعد ضبط التقدّم على الجهاز قبل ربط حساب جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spielstand auf diesem Gerät war mit einem anderen Game-Center-Account verknüpft. Zum Schutz dieses Spielstands ist das Teilen pausiert. Melde dich wieder mit dem bisherigen Account an oder setze den lokalen Fortschritt zurück, bevor du einen neuen Account verknüpfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze lokale opslag was gekoppeld aan een ander Game Center-account. Delen is gepauzeerd om die speler te beschermen. Keer terug naar dat account of reset de lokale voortgang voordat je een nieuw account koppelt."
          }
        }
      }
    },
