    "dino.friends.accountConflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان هذا الحفظ على الجهاز مرتبطًا بحساب آخر في Game Center. توقفت المشاركة لحماية ذلك اللاعب. عُد إلى الحساب السابق أو أعد ضبط التقدّم على الجهاز قبل ربط حساب جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spielstand auf diesem Gerät war mit einem anderen Game-Center-Account verknüpft. Zum Schutz dieses Spielstands ist das Teilen pausiert. Melde dich wieder mit dem bisherigen Account an oder setze den lokalen Fortschritt zurück, bevor du einen neuen Account verknüpfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This local save was linked to another Game Center account. Sharing is paused to protect that player. Return to that account, or reset local progress before linking a new account."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze lokale opslag was gekoppeld aan een ander Game Center-account. Delen is gepauzeerd om die speler te beschermen. Keer terug naar dat account of reset de lokale voortgang voordat je een nieuw account koppelt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末のセーブデータは別のGame Centerアカウントに連携されています。そのプレイヤーを保護するため、共有を一時停止しています。元のアカウントに戻すか、この端末の進み具合をリセットしてから新しいアカウントを連携してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机存档曾关联另一个 Game Center 账户。为保护该玩家，已暂停分享。请切回原账户，或重置本机进度后再关联新账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台裝置的進度曾連結到另一個 Game Center 帳號。為保護該玩家，已暫停分享。請切回原帳號，或重設本機進度後再連結新帳號。"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשחק שנשמר במכשיר שויך לחשבון Game Center אחר. השיתוף הופסק כדי להגן על השחקן שהחשבון שייך לו. אפשר לחזור לחשבון הקודם או לאפס את ההתקדמות המקומית לפני שמקשרים חשבון חדש."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس آلے کا محفوظ کھیل کسی دوسرے Game Center اکاؤنٹ سے جڑا تھا۔ اس کھلاڑی کی حفاظت کے لیے نتائج شیئر کرنا روک دیا گیا ہے۔ اسی اکاؤنٹ پر واپس جائیں، یا نیا اکاؤنٹ جوڑنے سے پہلے اس آلے کی پیش رفت مٹا دیں۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde locale était associée à un autre compte Game Center. Le partage est suspendu pour protéger ce joueur. Reviens à ce compte ou efface la progression locale avant d’associer un nouveau compte."
          }
        }
      }
    },
